# Project/backup archives
/.archive/
**/.archive/
docs/*.zip

# Local/editor clutter
..gitignore.kate-swp
*.kate-swp
*.swp
*.swo
*~
*.tmp
.DS_Store
Thumbs.db

# IDEs (optional)
.vscode/
.idea/
.obsidian/
.tempFix/

# Python / virtualenv
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/

# Node / Vite / React
node_modules/
dist/
out/
.vite/
.eslintcache
*.tsbuildinfo

# The pinned portable payload ships a verified WASI analyzer artifact.
!/tools/quality/rust_analyzer/dist/
!/tools/quality/rust_analyzer/dist/rust_quality_analyzer.wasm

# Logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Template-Tooling runtime and generated reports (state.toml stays versioned)
/.tooling-state/reports/
/.tooling-state/runtime/
/.tooling-state/venv/

# Rust / Tauri build output
target/                # ignores any Rust target/ (incl. src-tauri/target)
**/src-tauri/target/   # explicit, for clarity

# Tauri bundler outputs (falls sie ausserhalb von target landen)
*.AppImage
*.deb
*.rpm
*.dmg
*.msi
*.exe
*.app

# Local env files
.env
.env.*
!.env.example

# LaTeX build artifacts
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.bcf
*.blg
*.run.xml
*.fdb_latexmk
*.fls
*.synctex.gz
