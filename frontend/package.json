{
  "name": "fmd-flashcard-desktop",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint src *.config.ts --max-warnings=0",
    "preview": "vite preview",
    "tauri": "cd .. && node frontend/node_modules/@tauri-apps/cli/tauri.js",
    "test": "vitest",
    "test:run": "vitest run --watch=false",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.30.2",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.11",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "jsdom": "^24.1.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "8.68.0",
    "vite": "^7.3.2",
    "vitest": "^2.0.5"
  }
}
