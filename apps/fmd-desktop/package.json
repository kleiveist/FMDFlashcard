{
  "name": "fmd-flashcard-desktop",
  "private": true,
  "version": "1.0.0",
  "description": "Local-first Markdown flashcards and study tools for the desktop.",
  "author": "FMDFlashcard contributors",
  "homepage": "https://github.com/kleiveist/FMDFlashcard",
  "repository": {
    "type": "git",
    "url": "https://github.com/kleiveist/FMDFlashcard.git"
  },
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:run": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@cortex-js/compute-engine": "^0.30.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^9.0.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.11",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.0",
    "rehype-sanitize": "^6.0.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.5",
    "jsdom": "^24.1.3",
    "prettier": "3.9.6",
    "typescript-eslint": "8.69.0",
    "vitest": "2.1.9",
    "typescript": "~5.8.3",
    "vite": "^7.3.2",
    "@tauri-apps/cli": "^2"
  }
}
